# Copy to .env and adjust. All values are optional.

# Detector
MODEL_PATH=models/yolo11s.onnx
INPUT_SIZE=640
CONF_THRESHOLD=0.35
NMS_THRESHOLD=0.45
USE_CUDA=false

# People & scene understanding (a missing model file just disables its feature)
ENABLE_POSE=true
ENABLE_FACES=true
# Perceived gender + estimated age (appearance-based estimates)
ENABLE_DEMOGRAPHICS=true
ENABLE_SCENE=true
SCENE_OVERLAY=true
SCENE_INTERVAL_S=1.0
# Video speed/quality trade-offs: run these models every N frames
OBJECT_EVERY_N=2
FACE_EVERY_N=3

# Fire / smoke add-on (off by default)
ENABLE_HAZARDS=false
# HAZARD_MODEL_PATH=models/fire_smoke.onnx
# HAZARD_LABELS=["fire","smoke"]

# Streaming
STREAM_MAX_WIDTH=1280
JPEG_QUALITY=80
MAX_STREAMS=4
ALLOW_DEVICE_SOURCES=true
# Lets clients make the server connect to arbitrary URLs – only enable on trusted networks.
ALLOW_URL_SOURCES=false

# Uploads
MAX_IMAGE_MB=15
MAX_VIDEO_MB=300

LOG_LEVEL=INFO

# Accuracy (photos). Video uses MODEL_PATH (yolo11s, falls back to yolo11n).
IMAGE_MODEL=yolo11x.onnx
IMAGE_TILES=1
MAX_RECALL_TILES=2
MAX_RECALL_CONF=0.25
ENABLE_OPEN_VOCAB=true
